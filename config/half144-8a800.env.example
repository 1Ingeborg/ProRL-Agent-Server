# half144 online GRPO profile (run 20261014T044010-half144-8a800): first 144 train prompts, 12 rollouts.
# Copy to config/full300-6a800.env (scripts/autodl_train_full.sh reads that path) or pass TRAIN_PROFILE=...
TRAIN_SCOPE=half144
TRAIN_GPUS=8
ROLLOUT_GPUS=8
TRAIN_TP=2
ROLLOUT_TP=2
COLOCATE=1
OFFLOAD_TRAIN=0
ROLLOUT_BATCH_SIZE=12
N_SAMPLES_PER_PROMPT=8
NUM_ROLLOUT=12
START_ROLLOUT_ID=0
PROMPT_DATA="$POLAR_HOME/datasets/slime/train.jsonl"
CONTEXT_LENGTH=131072
MAX_TOKENS_PER_GPU=20480
SAVE_CHECKPOINT=1
CUDA_HOME=/usr/local/cuda-12.8
CUDA_LAUNCH_BLOCKING=0
POLAR_MAX_ASYNC_LEVEL=12
TRAIN_CP=4
POLAR_MIN_COMPLETE_ACCEPT_FRACTION=0.75
SAVE_ROOT="$POLAR_HOME/checkpoints/full300"
SAVE_INTERVAL=4
EVAL_INTERVAL=4
EVAL_PROMPT_DATA="$POLAR_HOME/datasets/slime/val.jsonl"
N_SAMPLES_PER_EVAL_PROMPT=1
# Data disk holds one checkpoint at a time; Aliyun scripts/pull_checkpoints.sh pulls each one after its eval and frees it here.
SAVE_DISK_COPIES=1
DISK_RESERVE_GB=8
SKIP_EVAL_BEFORE_TRAIN=0
