# Demo profile: all 300 SWE-smith train prompts for one epoch on 8 GPUs
# (25 rollouts x 12 prompts x 8 samples). Copy to config/full300-8a800.env.
TRAIN_SCOPE=full300
TRAIN_GPUS=8
ROLLOUT_GPUS=8
TRAIN_TP=2
ROLLOUT_TP=2
TRAIN_CP=4
COLOCATE=1
OFFLOAD_TRAIN=0
ROLLOUT_BATCH_SIZE=12
N_SAMPLES_PER_PROMPT=8
NUM_ROLLOUT=25
START_ROLLOUT_ID=0
PROMPT_DATA="$POLAR_HOME/datasets/slime/train.jsonl"
CONTEXT_LENGTH=131072
# Per-sample cap is MAX_TOKENS_PER_GPU * TRAIN_CP = 81920; longer trajectories are dropped.
MAX_TOKENS_PER_GPU=20480
POLAR_MAX_ASYNC_LEVEL=12
POLAR_MIN_COMPLETE_ACCEPT_FRACTION=0.75
CUDA_HOME=/usr/local/cuda-12.8
CUDA_LAUNCH_BLOCKING=0
# Baseline eval, then eval + save after rollouts 7, 14, 21 and 25 (end of epoch).
EVAL_PROMPT_DATA="$POLAR_HOME/datasets/slime/val.jsonl"
N_SAMPLES_PER_EVAL_PROMPT=1
EVAL_INTERVAL=7
SKIP_EVAL_BEFORE_TRAIN=0
SAVE_CHECKPOINT=1
SAVE_ROOT="$POLAR_HOME/checkpoints/full300"
SAVE_INTERVAL=7
# The data disk holds one checkpoint at a time; scripts/pull_checkpoints.sh moves each one off after its eval.
SAVE_DISK_COPIES=1
DISK_RESERVE_GB=8
